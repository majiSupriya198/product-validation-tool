# Copy to .env and fill in. Never commit .env.
# Databricks SQL warehouse connection (read-only use).
DBX_HOST=your-workspace.cloud.databricks.com
# Either a full HTTP path...
DBX_HTTP_PATH=/sql/1.0/warehouses/your_warehouse_id
# ...or just the warehouse id (used when DBX_HTTP_PATH is empty)
DBX_WAREHOUSE_ID=
# Personal access token. Leave empty to use OAuth (browser login via databricks-sql-connector).
DBX_TOKEN=
DBX_AUTH_TYPE=token   # token | databricks-oauth

DBX_CATALOG=common_catalog
DBX_SCHEMA=gather_data
DBX_DETAIL_TABLE=sku_detail_v2
DBX_SEARCH_TABLE=sku_search_v2

# Optional: path to a CA bundle (.pem) if you're behind a TLS-inspecting corporate proxy.
# Empty = the certifi bundle that ships with the venv.
DBX_CA_BUNDLE=

# Seconds before a query is cancelled
DBX_QUERY_TIMEOUT=300
